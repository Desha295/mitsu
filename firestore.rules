rules_version = '2';

// MITSU Firestore Security Rules
//
// Public content is readable according to its published/active state.
// Admin users can manage protected data.
// Student records are readable publicly only when active, while writes
// are restricted to admins.

service cloud.firestore {
match /databases/{database}/documents {

// -------------------------------------------------------------------
// Helper functions
// -------------------------------------------------------------------

function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() &&
    exists(
      /databases/$(database)/documents/admins/$(request.auth.uid)
    );
}

function isSuperAdmin() {
  return isAdmin() &&
    get(
      /databases/$(database)/documents/admins/$(request.auth.uid)
    ).data.role == 'super_admin';
}

// -------------------------------------------------------------------
// Public content collections
// -------------------------------------------------------------------

match /announcements/{id} {
  allow read: if resource.data.isPublished == true || isAdmin();
  allow write: if isAdmin();
}

match /events/{id} {
  allow read: if resource.data.isPublished == true || isAdmin();
  allow write: if isAdmin();
}

match /systems/{id} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}

match /committees/{id} {
  allow read: if true;
  allow write: if isAdmin();
}

match /committeeMembers/{id} {
  allow read: if true;
  allow write: if isAdmin();
}

match /leadership/{id} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}

match /facultyLeadership/{id} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}

match /documents/{id} {
  allow read: if resource.data.isPublished == true || isAdmin();
  allow write: if isAdmin();
}

match /hero/{id} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}

match /homepage/{id} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}

match /guide/{id} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}

// -------------------------------------------------------------------
// Notifications
// -------------------------------------------------------------------

// Public users can read published notifications.
// Admins can read all notifications and manage them.
match /notifications/{id} {
  allow read: if resource.data.isPublished == true || isAdmin();
  allow write: if isAdmin();
}

// -------------------------------------------------------------------
// Academic Advisors / Students
// -------------------------------------------------------------------

// Students can look up active student records by Student ID.
// Admins can read all student records and manage them.
match /students/{studentId} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}

// -------------------------------------------------------------------
// Settings
// -------------------------------------------------------------------

match /settings/{id} {
  allow read: if true;
  allow write: if isAdmin();
}

// -------------------------------------------------------------------
// Admins
// -------------------------------------------------------------------

// A signed-in user can read their own admin document.
// A super admin can read any admin document.
match /admins/{userId} {
  allow read: if isSignedIn() &&
    (
      request.auth.uid == userId ||
      isSuperAdmin()
    );

  allow write: if isSuperAdmin();
}
// -------------------------------------------------------------------
// Student Families
// -------------------------------------------------------------------

match /families/{familyId} {
  // Public users can read active families.
  // Admins can read and manage all families.
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();

  // Family Events
  match /events/{eventId} {
    // Public users can read family events.
    // Admins can read and manage all family events.
    allow read: if true;
    allow write: if isAdmin();
  }
}
// -------------------------------------------------------------------
// Social Links
// -------------------------------------------------------------------

// Public users can read active social links.
// Admins can read and manage all social links.
match /socialLinks/{id} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}
// -------------------------------------------------------------------
// Student Groups
// -------------------------------------------------------------------

// Public users can read active student groups.
// Admins can read and manage all student groups.
match /studentGroups/{id} {
  allow read: if resource.data.isActive == true || isAdmin();
  allow write: if isAdmin();
}
// -------------------------------------------------------------------
// Deny everything else by default
// -------------------------------------------------------------------

match /{document=**} {
  allow read, write: if false;
}

}
}
